{
  "expo": {
    "name": "دليل كوم",
    "slug": "dalilcom-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d6efd"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dalilcom.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0d6efd"
      },
      "package": "com.dalilcom.app",
      "versionCode": 2,
      "permissions": []
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d4e35eb0-f5a0-41e9-b09d-554cc458aa76"
      }
    },
    "owner": "yousef2006alsabbagh"
  }
}
